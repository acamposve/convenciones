  "tipos_empresa": [
    {
      "codigo": 1,
      "nombre": "Organismo",
      "descripcion": "Conjunto de oficinas, dependencias o empleos que forman un cuerpo o institución."
    },
    {
      "codigo": 8,
      "nombre": "Industria",
      "descripcion": "Actividad económica y técnica que consiste en transformar las materias primas hasta convertirlas en productos terminado adecuados para satisfacer las necesidades del hombre ."
    },
    {
      "codigo": 3,
      "nombre": "Fundación",
      "descripcion": "Institución dedicada al desarrollo de programas culturales, educativos, agrícolas y ambientales."
    },
    {
      "codigo": 4,
      "nombre": "Instituto Autónomo",
      "descripcion": "Son personas jurídicas de derecho público de naturaleza fundacional, creadas por el Estado mediante ley nacional, estadal u ordenanza municipal, con personalidad jurídica y patrimonio propio. En Venezuela existen numerosos institutos autónomos, creados por el Poder Nacional. Por la amplitud de los recursos que movilizan, la importancia de las materias que les han sido atribuidas y la gran cantidad de recursos humanos con los que cuentan, constituyen factores resaltantes de la administración pública."
    },
    {
      "codigo": 5,
      "nombre": "Asociación Civil",
      "descripcion": "Se denomina  asociación civil  a aquella entidad privada sin ánimo de lucro y con  personalidad jurídica  plena, integrada por  personas físicas  para el cumplimiento de fines culturales, educativos, de divulgación, deportivos, o de índole similar, con el objeto de fomentar entre sus socios y/o terceros alguna actividad socio-cultural."
    },
    {
      "codigo": 7,
      "nombre": "Ministerio",
      "descripcion": "Departamento de gobierno encargado de un área política determinada."
    },
    {
      "codigo": 9,
      "nombre": "Ente Bancario",
      "descripcion": "Una entidad bancaria (Bancos y Cajas de Ahorro) es una institución financiera que se encarga de administrar el dinero de unos para prestarlo a otros. La banca, o el sistema bancario, es el conjunto de entidades o instituciones que, dentro de una economía determinada, prestan el servicio de banco o banca ."
    },
    {
      "codigo": 10,
      "nombre": "Aseguradoras",
      "descripcion": "Una aseguradora, también designada en algunas partes como compañía de seguros, puede ser una persona física o una empresa que se ocupa de la aseguración de riesgos a terceros, es decir, su principal actividad consiste en resguardar a aquellos bienes materiales de determinados riesgos a los que están expuestos."
    },
    {
      "codigo": 21,
      "nombre": "Empresa",
      "descripcion": "ORGANIZACION EMPRESARIAL PUBLICA O PRIVADA"
    },
    {
      "codigo": 22,
      "nombre": "Cooperativa",
      "descripcion": "Las Cooperativas son empresas de producción de bienes y servicios, industrial, agrícola, pesquera, consumo, ahorro y préstamo, conformada por personas con un mismo fin económico y social, en donde el beneficio es determinado por la participación de cada socio y no por la cantidad de dinero que haya aportado."
    },
    {
      "codigo": 23,
      "nombre": "Empresa de Producción Social (EPS)",
      "descripcion": "Son entidades  integrales , ellas pueden ser empresas de   carácter   mercantil, civil o  cooperativas   pero con la  misión   de establecer nuevas formas de producción social y eficientes con una  distribución   de sus excedentes o beneficios en base a  principios   de  justicia ,   equidad   y reciprocidad hacia toda la  comunidad   que participa y el uso de  técnicas   y  tecnología ; y tienen como   objetivo   fundamental generar  bienes   y  servicios   que satisfagan las necesidades básicas y esenciales de las comunidades y su entorno ( alimentación , vestimenta, vivienda,   educación   y  salud ) a través del   trabajo   digno de hombres y mujeres).   Tienen la particularidad de destinar parte de sus ganancias generadas a un reparto equitativo entre sus miembros y otra parte se transfiere a planes y proyectos de desarrollo social de la comunidad."
    }
  ],
