<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Comparador.Api.Tests vive como subcarpeta de este proyecto — sin este exclude,
         el glob por defecto del SDK (**/*.cs) tambien compila los .cs del test project
         dentro de este ensamblado, y choca con sus propias referencias a xunit. -->
    <Compile Remove="Comparador.Api.Tests/**" />
    <Content Remove="Comparador.Api.Tests/**" />
    <EmbeddedResource Remove="Comparador.Api.Tests/**" />
    <None Remove="Comparador.Api.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Fase 4 (PLAN_MIGRACION_CSHARP_FIREBASE_LOGGING.md): abstraccion IChatClient para
         Claude. El paquete se instala en esta fase (3.1), pero se conecta recien en la
         Fase 4 (Microsoft.Extensions.AI/Anthropic). Sin uso todavia. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
  </ItemGroup>

</Project>
