# Configuración de desarrollo local
# Copia esto a .env y ajusta valores

## Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=comparador
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comparador

## API (.NET)
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=comparador-api

## AI Service (Python)
ANTHROPIC_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=optional-if-using-openai

## Frontend (React)
VITE_API_URL=http://localhost:5000
VITE_SERVICE_URL=http://localhost:8000

## Azure (cuando esté en producción)
# AZURE_STORAGE_CONNECTION_STRING=...
# AZURE_SERVICEBUS_CONNECTION_STRING=...
# AZURE_KEY_VAULT_URL=...

## Logging
LOG_LEVEL=Debug
