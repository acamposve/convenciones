POSTGRES_USER=convenciones
POSTGRES_PASSWORD=convenciones
POSTGRES_DB=convenciones
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

DATABASE_URL=postgresql://convenciones:convenciones@localhost:5433/convenciones

ANTHROPIC_API_KEY=

# api/ (.NET) y web/ (React) — auth (docs/auth-spec.md), consumidos por docker-compose.yml
JWT_SIGNING_KEY=dev-only-change-me-32-bytes-minimum
API_PORT=5080
WEB_PORT=5173

# Nombre del tenant demo creado por el bootstrap automatico (seed_admin_user.py / servicio
# "seed" en docker-compose.yml) si todavia no existe ningun tenant.
TENANT_DEMO_NOMBRE=Empresa Demo
